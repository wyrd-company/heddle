{
  "heddle-custom-paths": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "heddle": {
        "configFile": "/mnt/config/service.yml",
        "stateDirectory": "/mnt/state",
        "githubAppCredentialsFile": "/mnt/secrets/github-app.yml",
        "t3CodeTokenFile": "/mnt/secrets/t3-token",
        "webhookSecretFile": "/mnt/secrets/webhook-secret",
        "serviceUser": "vscode"
      }
    }
  }
}
