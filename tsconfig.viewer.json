{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "outDir": null,
    "rootDir": null,
    "skipLibCheck": true
  },
  "include": [
    "src/console/lifecycle-canvas-projection.tsx",
    "src/console/lifecycle-viewer.tsx"
  ]
}
