{
  "name": "Heddle feature qualification",
  "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
  "features": {
    "ghcr.io/wyrd-company/devcontainers/caddy:1": {},
    "../features/heddle": {
      "statePath": "/var/lib/heddle",
      "port": "4317",
      "dnsName": "heddle.qualification.test"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HEDDLE_QUALIFICATION_STATE}",
      "target": "/var/lib/heddle",
      "type": "bind"
    }
  ],
  "remoteUser": "vscode",
  "runArgs": ["--add-host", "heddle.qualification.test:127.0.0.1"],
  "overrideCommand": false,
  "shutdownAction": "none"
}
