{
  "name": "Heddle driver qualification",
  "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
  "features": {
    "ghcr.io/wyrd-company/devcontainers/claude-code-cli:1": {},
    "ghcr.io/wyrd-company/devcontainers/codex-cli:1": {},
    "ghcr.io/wyrd-company/devcontainers/cursor-agent-cli:1": {}
  },
  "mounts": [
    {
      "source": "${localEnv:HEDDLE_DRIVER_STATE}",
      "target": "/var/lib/heddle",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_BOARD}",
      "target": "/workspaces/kanban",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_KANBAN}",
      "target": "/usr/local/bin/kanban-md",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_CLAUDE_STATE}",
      "target": "/home/vscode/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_CLAUDE_CONFIG}",
      "target": "/home/vscode/.claude.json",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_CODEX_STATE}",
      "target": "/home/vscode/.codex",
      "type": "bind"
    },
    {
      "source": "${localEnv:HEDDLE_DRIVER_CURSOR_STATE}",
      "target": "/home/vscode/.cursor",
      "type": "bind"
    }
  ],
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/heddle",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/heddle,type=bind"
}
