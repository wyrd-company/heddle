{
  "$id": "https://wyrd.company/heddle/production-configuration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "relationships": { "implements": "heddle" },
  "$comment": "This schema validates the effective configuration after config.yml and optional worker.yml are layered over built-in defaults. Source documents may be partial and use null to restore a built-in value or remove an inherited optional value.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "pacing": {
            "properties": {
              "providerBudgets": { "minProperties": 1 }
            },
            "required": ["providerBudgets"]
          }
        },
        "required": ["pacing"]
      },
      "then": { "required": ["providerUsage"] },
      "else": { "not": { "required": ["providerUsage"] } }
    }
  ],
  "required": [
    "adHocProject",
    "boardDirectory",
    "cadenceMilliseconds",
    "incident",
    "observationThresholds",
    "pacing",
    "providerAliases",
    "pushover",
    "session",
    "stageThresholds",
    "stateDirectory",
    "stopTimeoutMilliseconds",
    "t3"
  ],
  "properties": {
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerAlias"],
      "properties": {
        "approvalSettlementMilliseconds": {
          "description": "How long a sanctioned approval may remain pending after Heddle durably issues its response.",
          "type": "integer",
          "minimum": 1,
          "default": 60000
        },
        "policyPath": {
          "$comment": "Where the decision boundary lives in the blueprint repository. Omitted reads the conventional adjudication/policy.json.",
          "type": "string",
          "pattern": "^adjudication/[a-z][a-z-]*\\.json$"
        },
        "providerAlias": { "type": "string", "minLength": 1 }
      }
    },
    "adHocProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceRoot"],
      "properties": {
        "label": { "type": "string", "pattern": "\\S" },
        "workspaceRoot": { "type": "string", "pattern": "^/" }
      }
    },
    "boardDirectory": { "type": "string", "pattern": "^/" },
    "cadenceMilliseconds": { "type": "integer", "minimum": 1 },
    "observationThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endedMilliseconds",
        "failedMilliseconds",
        "stalledMilliseconds"
      ],
      "properties": {
        "endedMilliseconds": { "type": "integer", "minimum": 1 },
        "failedMilliseconds": { "type": "integer", "minimum": 1 },
        "stalledMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentSessions",
        "providerBudgets",
        "subagents",
        "usageWindowHours"
      ],
      "properties": {
        "maxConcurrentSessions": { "type": "integer", "minimum": 0 },
        "providerBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usageLimit"],
            "properties": { "usageLimit": { "type": "number", "minimum": 0 } }
          }
        },
        "subagents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxDepth", "maxFanOut"],
          "properties": {
            "maxDepth": { "type": "integer", "minimum": 0 },
            "maxFanOut": { "type": "integer", "minimum": 0 }
          }
        },
        "usageWindowHours": { "const": 5 }
      }
    },
    "providerAliases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/providerAliasCandidate" },
          {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/providerAliasCandidate" }
          }
        ]
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failureThreshold",
        "githubIssueRepository",
        "retryDelayMilliseconds",
        "workspaceRoot"
      ],
      "properties": {
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "githubIssueRepository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "immediateEscalationCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "retryDelayMilliseconds": { "type": "integer", "minimum": 1 },
        "workspaceRoot": { "type": "string", "pattern": "^/" }
      }
    },
    "providerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "arguments": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "pattern": "^[^\\u0000]*$" }
        },
        "executable": { "type": "string", "pattern": "^/" },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 10000
        }
      }
    },
    "pushover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiUrl", "applicationToken", "consoleBaseUrl", "userKey"],
      "properties": {
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "applicationToken": { "$ref": "#/$defs/secretValue" },
        "consoleBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "recipientLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "userKey": { "$ref": "#/$defs/secretValue" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRef", "defaultProviderAlias", "defaultRuntimeMode"],
      "properties": {
        "baseRef": { "type": "string", "minLength": 1 },
        "defaultProviderAlias": { "type": "string", "minLength": 1 },
        "defaultReasoningEffort": {
          "$comment": "The provider's own reasoning effort token every session starts from. Omitted leaves each provider at its own default.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "defaultRuntimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "interactionMode": {
          "$comment": "One of the interaction modes T3 publishes. Omitted leaves every session at T3's own default.",
          "enum": ["default", "plan"]
        },
        "worktreesRoot": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "stageThresholds": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "stateDirectory": {
      "description": "Worker-owned writable state root. Heddle keeps this worker's blueprint synchronization checkout in its blueprints subdirectory. The checkout and shared blueprint source must be disjoint.",
      "type": "string",
      "pattern": "^/"
    },
    "stopTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
    "t3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessToken", "baseUrl"],
      "properties": {
        "accessToken": { "$ref": "#/$defs/secretValue" },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    }
  },
  "$defs": {
    "secretValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      ]
    },
    "providerAliasCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerDisplayName", "model"],
      "properties": {
        "providerDisplayName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reasoningEffort": {
          "$comment": "The provider's own reasoning effort token for this candidate's model. Overrides session.defaultReasoningEffort.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    }
  }
}
