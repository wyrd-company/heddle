{
  "$id": "https://wyrd.company/heddle/production-configuration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "relationships": { "implements": "heddle" },
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "pacing": {
            "properties": {
              "providerBudgets": { "minProperties": 1 }
            },
            "required": ["providerBudgets"]
          }
        },
        "required": ["pacing"]
      },
      "then": { "required": ["providerUsage"] },
      "else": { "not": { "required": ["providerUsage"] } }
    }
  ],
  "required": [
    "adHocProject",
    "boardDirectory",
    "cadenceMilliseconds",
    "incident",
    "observationThresholds",
    "pacing",
    "products",
    "providerAliases",
    "pushover",
    "session",
    "stageThresholds",
    "stateDirectory",
    "stopTimeoutMilliseconds",
    "t3"
  ],
  "properties": {
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyPath", "providerAlias"],
      "properties": {
        "approvalSettlementMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "policyPath": {
          "type": "string",
          "pattern": "^adjudication/[a-z][a-z-]*\\.json$"
        },
        "providerAlias": { "type": "string", "minLength": 1 }
      }
    },
    "adHocProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "projectId", "workspaceRoot"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "pattern": "^/" }
      }
    },
    "boardDirectory": { "type": "string", "pattern": "^/" },
    "cadenceMilliseconds": { "type": "integer", "minimum": 1 },
    "observationThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endedMilliseconds",
        "failedMilliseconds",
        "stalledMilliseconds"
      ],
      "properties": {
        "endedMilliseconds": { "type": "integer", "minimum": 1 },
        "failedMilliseconds": { "type": "integer", "minimum": 1 },
        "stalledMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentSessions",
        "providerBudgets",
        "subagents",
        "usageWindowHours"
      ],
      "properties": {
        "maxConcurrentSessions": { "type": "integer", "minimum": 0 },
        "providerBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usageLimit"],
            "properties": { "usageLimit": { "type": "number", "minimum": 0 } }
          }
        },
        "subagents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxDepth", "maxFanOut"],
          "properties": {
            "maxDepth": { "type": "integer", "minimum": 0 },
            "maxFanOut": { "type": "integer", "minimum": 0 }
          }
        },
        "usageWindowHours": { "const": 5 }
      }
    },
    "providerAliases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/providerAliasCandidate" },
          {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/providerAliasCandidate" }
          }
        ]
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalSeverityThreshold",
        "failureThreshold",
        "githubIssueRepository",
        "retryDelayMilliseconds",
        "workspaceRoot"
      ],
      "properties": {
        "approvalSeverityThreshold": {
          "enum": ["low", "moderate", "high", "critical"]
        },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "githubIssueRepository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "immediateEscalationCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "retryDelayMilliseconds": { "type": "integer", "minimum": 1 },
        "workspaceRoot": { "type": "string", "pattern": "^/" }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repos"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "repositoryRoot"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "repositoryRoot": { "type": "string", "pattern": "^/" }
              }
            }
          },
          "epicProject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["epicId", "projectId"],
            "properties": {
              "epicId": { "type": "integer", "minimum": 1 },
              "projectId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "providerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "arguments": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "pattern": "^[^\\u0000]*$" }
        },
        "executable": { "type": "string", "pattern": "^/" },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 10000
        }
      }
    },
    "pushover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiUrl", "applicationToken", "consoleBaseUrl", "userKey"],
      "properties": {
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "applicationToken": { "type": "string", "minLength": 1 },
        "consoleBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "recipientLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "userKey": { "type": "string", "minLength": 1 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRef",
        "defaultProviderAlias",
        "defaultRuntimeMode",
        "interactionMode",
        "skillPointer"
      ],
      "properties": {
        "baseRef": { "type": "string", "minLength": 1 },
        "defaultProviderAlias": { "type": "string", "minLength": 1 },
        "defaultRuntimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "interactionMode": { "type": "string", "minLength": 1 },
        "skillPointer": { "type": "string", "minLength": 1 },
        "worktreesRoot": { "type": "string", "pattern": "^/" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "host": { "const": "127.0.0.1", "default": "127.0.0.1" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3774
        }
      }
    },
    "stageThresholds": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "stateDirectory": { "type": "string", "pattern": "^/" },
    "stopTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
    "t3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessToken", "baseUrl"],
      "properties": {
        "accessToken": { "type": "string", "minLength": 1 },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    }
  },
  "$defs": {
    "providerAliasCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerDisplayName", "model"],
      "properties": {
        "providerDisplayName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
