{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrd.company/heddle/todo-template.schema.json",
  "relationships": {
    "implements": "heddle"
  },
  "title": "Heddle todo template",
  "description": "A repository-resident checklist instantiated for one workflow stage activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "relationships", "items"],
  "properties": {
    "$schema": {
      "const": "https://wyrd.company/heddle/todo-template.schema.json"
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implements"],
      "properties": {
        "implements": {
          "const": "heddle"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[^{}]|\\{\\{task\\.[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*\\}\\})+$"
        }
      }
    }
  }
}
