{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrd.company/heddle/lifecycle-blueprint.schema.json",
  "relationships": {
    "implements": "heddle"
  },
  "title": "Heddle lifecycle blueprint",
  "description": "A repository-resident Flowcraft graph that defines one task delivery lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "relationships", "nodes", "edges"],
  "properties": {
    "$schema": {
      "const": "https://wyrd.company/heddle/lifecycle-blueprint.schema.json"
    },
    "relationships": {
      "$ref": "#/$defs/relationships"
    },
    "metadata": {
      "type": "object"
    },
    "board-statuses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepare-worktree": {
          "$ref": "#/$defs/board-status"
        },
        "review-snapshot": {
          "$ref": "#/$defs/board-status"
        },
        "merge": {
          "$ref": "#/$defs/board-status"
        },
        "finalize": {
          "$ref": "#/$defs/board-status"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "board-status": {
      "type": "string",
      "minLength": 1
    },
    "artifact-id": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*$"
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implements"],
      "properties": {
        "implements": {
          "const": "heddle"
        },
        "uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact-id"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifact-id"
        },
        "uses": {
          "$ref": "#/$defs/artifact-id"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(?:_[a-z]+)*$"
          }
        },
        "handoff": {
          "enum": ["standard", "remediation"]
        },
        "handoff-template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commitSha", "path"],
          "properties": {
            "commitSha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "path": {
              "type": "string",
              "pattern": "^handoff-templates/[a-z]+(?:-[a-z]+)*\\.md$"
            }
          }
        },
        "repo": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "provider-alias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "runtime-mode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "assign-agent-name": {
          "enum": [
            "leader",
            "companions",
            "allies",
            "antagonists",
            "neutrals",
            "heroes",
            "villains",
            "bystanders"
          ]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact-id"
              },
              {
                "maxLength": 64
              }
            ]
          }
        },
        "todo-template": {
          "$ref": "#/$defs/artifact-id"
        },
        "params": {
          "type": "object"
        },
        "inputs": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 0
            },
            "retryDelay": {
              "type": "number",
              "minimum": 0
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fallback": {
              "$ref": "#/$defs/artifact-id"
            },
            "joinStrategy": {
              "enum": ["all", "any"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "uses": {
                "const": "wait"
              }
            },
            "required": ["uses"]
          },
          "then": {
            "required": [
              "handoff",
              "handoff-template",
              "tools",
              "todo-template"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["tools"]
                },
                {
                  "required": ["todo-template"]
                },
                {
                  "required": ["handoff"]
                },
                {
                  "required": ["handoff-template"]
                },
                {
                  "required": ["repo"]
                },
                {
                  "required": ["skills"]
                },
                {
                  "required": ["provider-alias"]
                },
                {
                  "required": ["runtime-mode"]
                },
                {
                  "required": ["assign-agent-name"]
                }
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {
          "$ref": "#/$defs/artifact-id"
        },
        "target": {
          "$ref": "#/$defs/artifact-id"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "output-contract": {
          "enum": ["incident-diagnosis", "optional", "review-findings"]
        }
      },
      "dependentRequired": {
        "output-contract": ["disposition"],
        "disposition": ["condition", "description"]
      }
    }
  }
}
