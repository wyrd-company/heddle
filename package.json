{
  "name": "heddle",
  "version": "1.0.0",
  "description": "Workflow service for software delivery tasks",
  "private": true,
  "bin": {
    "heddle-cursor-agent": "bin/heddle-cursor-agent.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src bin eslint.config.js && prettier --check README.md package.json Taskfile.yml tsconfig.json eslint.config.js vitest.config.ts src bin",
    "format": "prettier --write README.md package.json Taskfile.yml tsconfig.json eslint.config.js vitest.config.ts src bin"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "ajv": "^8.20.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@flowcraft/sqlite-history": "^1.0.0-beta.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.11.1",
    "flowcraft": "2.10.1",
    "zod": "^4.2.1"
  }
}
