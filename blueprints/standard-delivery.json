{
  "$schema": "https://wyrd.company/heddle/lifecycle-blueprint.schema.json",
  "relationships": {
    "implements": "heddle",
    "uses": [
      "standard-delivery-implement",
      "standard-delivery-review",
      "standard-delivery-remediate",
      "standard-delivery-retrospective"
    ]
  },
  "nodes": [
    {
      "id": "prepare-worktree",
      "uses": "prepare-worktree"
    },
    {
      "id": "implement",
      "handoff": "standard",
      "uses": "wait",
      "tools": [
        "advance",
        "get_task_context",
        "report_blocked",
        "escalate",
        "create_follow_up",
        "create_finding",
        "todo_list",
        "todo_check",
        "todo_add",
        "todo_edit",
        "todo_reorder",
        "spawn",
        "liveness",
        "answer"
      ],
      "todo-template": "standard-delivery-implement"
    },
    {
      "id": "review-snapshot",
      "uses": "review-snapshot",
      "config": {
        "joinStrategy": "any"
      }
    },
    {
      "id": "review",
      "handoff": "standard",
      "uses": "wait",
      "tools": [
        "advance",
        "get_task_context",
        "report_blocked",
        "escalate",
        "create_follow_up",
        "create_finding",
        "todo_list",
        "todo_check",
        "todo_add",
        "todo_edit",
        "todo_reorder",
        "spawn",
        "liveness",
        "answer"
      ],
      "todo-template": "standard-delivery-review",
      "config": {
        "joinStrategy": "any"
      }
    },
    {
      "id": "remediate",
      "handoff": "remediation",
      "uses": "wait",
      "tools": [
        "advance",
        "get_task_context",
        "report_blocked",
        "escalate",
        "create_follow_up",
        "create_finding",
        "todo_list",
        "todo_check",
        "todo_add",
        "todo_edit",
        "todo_reorder",
        "spawn",
        "liveness",
        "answer"
      ],
      "todo-template": "standard-delivery-remediate",
      "config": {
        "joinStrategy": "any"
      }
    },
    {
      "id": "merge",
      "uses": "merge",
      "config": {
        "joinStrategy": "any"
      }
    },
    {
      "id": "retrospective",
      "handoff": "standard",
      "uses": "wait",
      "tools": [
        "advance",
        "get_task_context",
        "report_blocked",
        "escalate",
        "create_follow_up",
        "todo_list",
        "todo_check",
        "todo_add",
        "todo_edit",
        "todo_reorder"
      ],
      "todo-template": "standard-delivery-retrospective"
    },
    {
      "id": "finalize",
      "uses": "finalize"
    }
  ],
  "edges": [
    {
      "source": "prepare-worktree",
      "target": "implement"
    },
    {
      "source": "implement",
      "target": "review-snapshot",
      "condition": "result.output.dispositions.complete",
      "disposition": "complete",
      "description": "Implementation is ready for a review snapshot"
    },
    {
      "source": "review-snapshot",
      "target": "review"
    },
    {
      "source": "review",
      "target": "merge",
      "condition": "result.output.dispositions.approve",
      "disposition": "approve",
      "description": "Approve the reviewed change"
    },
    {
      "source": "review",
      "target": "remediate",
      "condition": "result.output.dispositions.reject",
      "disposition": "reject",
      "description": "Return the reviewed change for remediation"
    },
    {
      "source": "remediate",
      "target": "review-snapshot",
      "condition": "result.output.dispositions.complete",
      "disposition": "complete",
      "description": "Remediation is ready for another review snapshot"
    },
    {
      "source": "merge",
      "target": "retrospective",
      "condition": "result.output.dispositions.merged",
      "disposition": "merged",
      "description": "Continue after merging the exact reviewed head"
    },
    {
      "source": "merge",
      "target": "remediate",
      "condition": "result.output.dispositions.remediate",
      "disposition": "remediate",
      "description": "Return snapshot and branch-head drift for remediation"
    },
    {
      "source": "retrospective",
      "target": "finalize",
      "condition": "result.output.dispositions.complete",
      "disposition": "complete",
      "description": "Retrospective is complete"
    }
  ]
}
